# ── Obrigatórias ──────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sua-chave-secreta-aqui

# Chave da API Groq (https://console.groq.com)
GROQ_API_KEY=gsk_...

# ── Ambiente ──────────────────────────────────────────────────
# "development" ou "production"
# Em production, SECRET_KEY ausente causa abort na inicialização
ENV=development

# ── Banco de dados ────────────────────────────────────────────
# SQLite (padrão dev — NÃO usar em produção, filesystem efêmero no Railway):
DATABASE_URL=sqlite:///./condominio.db
# PostgreSQL (produção — Railway provisiona automaticamente):
# DATABASE_URL=postgresql://usuario:senha@host:5432/condominio

# ── CORS ──────────────────────────────────────────────────────
# Dev:
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Produção (substitua pelo domínio real):
# ALLOWED_ORIGINS=https://app.condosys.com.br

# ── URLs da aplicação ─────────────────────────────────────────
# APP_URL: URL base do backend (usada em links de e-mail)
APP_URL=http://localhost:8000
# FRONTEND_URL: URL base do frontend (usada no link de convite de morador)
FRONTEND_URL=http://localhost:5500

# ── E-mail / SMTP ─────────────────────────────────────────────
# Sem SMTP_HOST configurado, e-mails são apenas logados no console (modo dev).
# Em produção, configure um provedor SMTP:
#   Gmail:    smtp.gmail.com / 587 (use App Password)
#   SendGrid: smtp.sendgrid.net / 587
#   Resend:   smtp.resend.com / 465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Nome exibido no remetente (opcional, padrão: SMTP_USER)
EMAIL_FROM=CONDO//SYS <noreply@condosys.com.br>
